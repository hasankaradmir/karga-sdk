{
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}
      },
      "required": ["repository", "tag"]
    },
    "workload": {
      "type": "object",
      "properties": {
        "restartPolicy": {"enum": ["always", "on-failure", "unless-stopped", "never"]}
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "storage": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    },
    "config": {
      "type": "object",
      "properties": {
        "maxmemory": {"type": "string"},
        "maxmemoryPolicy": {"type": "string"}
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "memory": {"type": "string"},
        "cpu": {"type": ["number", "string"]}
      }
    }
  },
  "required": ["image"]
}
