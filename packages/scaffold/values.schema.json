{
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}
      },
      "required": ["repository", "tag"]
    },
    "service": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "expose": {
      "type": "object",
      "properties": {
        "listener": {"type": "string", "minLength": 1},
        "host": {"type": "string"}
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "memory": {"type": "string"},
        "cpu": {"type": ["number", "string"]}
      }
    }
  }
}
